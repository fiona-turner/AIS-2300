as.vector(crossprod(prior_current_sd[i, ] * Vt))
})
prior_current_varx <- do.call("cbind", prior_current_varx)
dim(prior_current_varx) <- c(n, n)
#store
prior_slr_trajectories[i,] <- prior_current_meanx
}
